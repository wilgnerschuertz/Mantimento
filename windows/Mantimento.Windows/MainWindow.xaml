<Window x:Class="Mantimento.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mantimento" Width="1120" Height="800" MinWidth="760" MinHeight="600" SizeChanged="WindowSizeChanged" Closing="WindowClosing">
 <Window.InputBindings><KeyBinding Key="N" Modifiers="Control" Command="{Binding NewChatCommand}"/></Window.InputBindings>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="14">
   <DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top">
    <TextBlock Text="✦ Mantimento" FontSize="23" FontWeight="SemiBold" Margin="8,10,0,4"/><TextBlock Text="Conhecimento que fica" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,22"/>
    <Button Content="Conversa" Click="ChatPageClick" HorizontalContentAlignment="Left"/><Button Content="Modelos" Click="ModelsPageClick" HorizontalContentAlignment="Left"/><Button Content="Ajustes" Click="SettingsPageClick" HorizontalContentAlignment="Left"/>
    <Separator Margin="0,14"/><Button x:Name="NewChatButton" Content="＋ Nova conversa" Style="{StaticResource PrimaryButton}" Click="NewChatClick"/><TextBox x:Name="SearchBox" Margin="3,12,3,8" ToolTip="Buscar conversas" TextChanged="SearchChanged"/>
   </StackPanel><TextBlock DockPanel.Dock="Bottom" Text="Local · Windows x64" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,14"/>
   <ListBox x:Name="HistoryList" SelectionChanged="HistoryChanged" Background="Transparent" BorderThickness="0" DisplayMemberPath="Title" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="14,12"><Button Content="☰" DockPanel.Dock="Left" Click="ToggleSidebar" AutomationProperties.Name="Mostrar ou ocultar navegação"/>
    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="Processamento" VerticalAlignment="Center" Margin="8,0"/><ComboBox x:Name="ComputeBox" SelectionChanged="ComputeChanged" Width="136"><ComboBoxItem Content="CPU"/><ComboBoxItem Content="GPU"/><ComboBoxItem Content="Automático"/></ComboBox><Button x:Name="StartButton" Content="Iniciar modelo" Click="StartClick" Style="{StaticResource PrimaryButton}"/><Button x:Name="StopModelButton" Content="Desligar" Click="StopModelClick"/></WrapPanel>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="ChatPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="22,4,22,10"><TextBlock x:Name="ChatTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="ModelLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8"/>
      <WrapPanel><Button x:Name="FolderButton" Content="Pasta desta conversa…" Click="FolderClick"/><CheckBox x:Name="AgentBox" Content="Agente de arquivos e terminal" Checked="AgentChanged" Unchecked="AgentChanged"/><CheckBox x:Name="FullControlBox" Content="Controle total" Visibility="Collapsed"/></WrapPanel>
     </StackPanel>
     <Grid Grid.Row="1"><ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ChatMouseWheel"><ItemsControl x:Name="MessagesList" MaxWidth="820" HorizontalAlignment="Stretch" Margin="18,8"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><DockPanel><Button Content="Copiar" DockPanel.Dock="Right" Click="CopyMessageClick" Tag="{Binding Content}" FontSize="12" Padding="7,3"/><TextBlock Text="{Binding Author}" FontWeight="SemiBold" Margin="0,4,0,12"/></DockPanel><TextBox Text="{Binding Content,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0" Background="Transparent" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Button x:Name="LatestButton" Content="↓ Última mensagem" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12" Click="LatestClick" Visibility="Collapsed"/></Grid>
     <StackPanel Grid.Row="2" Margin="18,6,18,14"><DockPanel><Button x:Name="SendButton" DockPanel.Dock="Right" Content="Enviar ↑" Click="SendClick" Style="{StaticResource PrimaryButton}"/><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Interromper" Click="CancelClick" Visibility="Collapsed"/><TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="112" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputKeyDown" ToolTip="Mensagem · Ctrl+Enter para enviar"/></DockPanel><TextBlock Text="Ctrl+Enter para enviar · respostas podem conter erros" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="4,6,0,0"/></StackPanel>
    </Grid>
    <ScrollViewer x:Name="ModelsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="900"><TextBlock Text="Sua biblioteca de IA" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Modelos GGUF para Windows. O formato MLX do Mac não é compatível. Comece pelo 0.8B para avaliar a velocidade da sua máquina." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,22"/>
     <ItemsControl x:Name="ModelsList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"/><WrapPanel><Button Content="Baixar / retomar" Tag="{Binding Model}" Click="DownloadClick"/><Button Content="Usar" Tag="{Binding Model}" Click="UseModelClick"/><Button Content="Remover…" Tag="{Binding Model}" Click="RemoveModelClick"/><Button Content="Licença e detalhes ↗" Tag="{Binding Model}" Click="ModelDetailsClick"/></WrapPanel><TextBlock Text="{Binding Installed}" FontSize="12" Margin="2,8"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="Importar arquivo GGUF local…" Click="ImportModelClick" HorizontalAlignment="Left"/><TextBlock Text="A importação local é para modelos GGUF de texto. A compatibilidade e o uso de ferramentas variam com o modelo." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="780"><TextBlock Text="Ajustes e dados" FontSize="28" FontWeight="SemiBold"/>
     <Border Style="{StaticResource Card}" Margin="0,20,0,16"><StackPanel><TextBlock Text="Aparência e respostas" FontSize="19" FontWeight="SemiBold"/><WrapPanel Margin="0,12"><TextBlock Text="Tema" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="ThemeBox" SelectionChanged="ThemeChanged"><ComboBoxItem Content="Sistema"/><ComboBoxItem Content="Claro"/><ComboBoxItem Content="Escuro"/></ComboBox><TextBlock Text="Limite de resposta" VerticalAlignment="Center" Margin="12,4,4,4"/><ComboBox x:Name="TokensBox" SelectionChanged="TokensChanged"><ComboBoxItem Content="512"/><ComboBoxItem Content="1024"/><ComboBoxItem Content="2048"/></ComboBox></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU, GPU ou Automático" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="CPU funciona sem placa dedicada. GPU usa Vulkan e exige driver compatível; pode precisar de mais VRAM. Automático tenta GPU e volta para CPU se ela não estiver disponível. Desligue o modelo antes de trocar." Margin="0,10"/><TextBlock Text="O modo GPU é experimental. Na primeira versão, a prioridade é compatibilidade por CPU, não a maior velocidade possível." Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Conversas e documentos" FontSize="19" FontWeight="SemiBold"/><WrapPanel Margin="0,12"><Button Content="Exportar conversa JSON…" Click="ExportClick"/><Button Content="Importar conversa JSON…" Click="ImportChatClick"/><Button Content="Abrir pasta de dados" Click="OpenDataClick"/></WrapPanel><TextBlock Text="Importar uma conversa cria uma nova pasta de trabalho. Não há sincronização automática entre computadores. Modelos e documentos não são enviados à nuvem pelo chat." Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Limites desta prévia Windows" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Leitura e edição de texto UTF-8; sem PDF/OCR nesta primeira versão. Sem kit de restauração pela interface. PowerShell sem sandbox e com as permissões do usuário; comece com Revisar ações (Controle total desmarcado). Backups de escrita não cobrem comandos do terminal." Margin="0,10"/><Button Content="Relatar problema ↗" Click="IssuesClick" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10"><StackPanel><ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,8"/><DockPanel><Button Content="Registros" DockPanel.Dock="Right" Click="LogsClick"/><Button x:Name="CancelOperationButton" Content="Interromper tarefa" DockPanel.Dock="Right" Click="CancelClick" Visibility="Collapsed"/><TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Text="Baixe um modelo para começar." Foreground="{DynamicResource MutedBrush}"/></DockPanel></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
